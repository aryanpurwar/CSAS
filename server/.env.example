# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/csas

# Generate both with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-hex-characters-from-the-command-above-xxxxxxxx
DATA_ENC_KEY=replace-with-64-hex-characters-from-the-command-above-xxxxxxxx

PUBLIC_URL=http://localhost:5173
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
REQUIRE_ADMIN_MFA=false
RETENTION_DAYS=7
POST_TEST_MIN_SESSIONS=4
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=it-helpdesk@campus-mail.test
SERVE_CLIENT=false
LOG_LEVEL=info
